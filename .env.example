# Site
NEXT_PUBLIC_SITE_URL=https://mauricegarcia.com
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GA_ID=

# Preview deployments only: show "proposed" content awaiting the owner's approval.
# Ignored automatically on a Vercel production deployment.
SITE_PREVIEW=

# Stripe Checkout (shop still works via mailto if these are missing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Contact form: requires Resend; destination is fixed in lib/contact.ts
RESEND_API_KEY=
# Public recipient: hello@mauricegarcia.com (Porkbun forwards to maurice.garcia+site@gmail.com)
CONTACT_FROM_EMAIL=Maurice Garcia site <noreply@mauricegarcia.com>

# Owner studio (/studio). All server-side. Leave blank to keep the studio switched off.
STUDIO_PASSPHRASE=            # 12+ characters; what you type to sign in
STUDIO_SESSION_SECRET=        # 32+ random characters, e.g. `openssl rand -base64 48`
STUDIO_GITHUB_TOKEN=          # fine-grained token for THIS repo: Contents: write (+ Actions: write for "Sync now")
STUDIO_GITHUB_REPO=mosrvs2025/mauricegarcia.com
STUDIO_GITHUB_BRANCH=main
# Local development only (refused in production): edit files on disk and commit them with git
# STUDIO_STORAGE=fs
